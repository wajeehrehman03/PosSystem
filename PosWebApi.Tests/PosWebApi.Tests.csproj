<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0</TargetFramework>
	<IsTestProject>true</IsTestProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<!-- xUnit Testing Framework -->
	<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
	<PackageReference Include="xunit" Version="2.7.0" />
	<PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>

	<!-- Microsoft Test SDK -->
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />

	<!-- Mocking Framework -->
	<PackageReference Include="Moq" Version="4.20.70" />

	<!-- Fluent Assertions -->
	<PackageReference Include="FluentAssertions" Version="6.12.0" />

	<!-- ASP.NET Core Testing Utilities -->
	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />

	<!-- Entity Framework Core In-Memory Database -->
	<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />

	<!-- Code Coverage -->
	<PackageReference Include="coverlet.collector" Version="6.0.0">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>

	<!-- OpenCover for Code Coverage Analysis -->
	<PackageReference Include="OpenCover" Version="4.7.1221">
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>

	<!-- ReportGenerator for Coverage Reports -->
	<PackageReference Include="ReportGenerator" Version="5.2.0">
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
	<!-- Reference the main project being tested -->
	<ProjectReference Include="../PosWebApi.csproj" />
  </ItemGroup>

  <!-- Test Configuration -->
  <Target Name="GenerateCoverageReport" AfterTargets="Test">
	<Exec Command="reportgenerator -reports:&quot;$(ProjectDir)coverage.opencover.xml&quot; -targetdir:&quot;$(ProjectDir)CoverageReport&quot;" ContinueOnError="true" />
  </Target>

</Project>
